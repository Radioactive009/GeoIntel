# Base URL of the GeoIntel backend.
#
# Local development (leave unset to use the default):
#   VITE_API_URL=http://localhost:8000
#
# Production: this MUST be set at build time. Vite inlines the value into the
# bundle, so a build without it ships "http://localhost:8000" and the deployed
# dashboard loads no news.
VITE_API_URL=http://localhost:8000

# Optional 3D avatar for the voice assistant, as a .glb URL.
#
# Build one free at https://readyplayer.me — it turns a selfie into a rigged
# avatar and hands back a URL ending in .glb. Request the ARKit blendshapes so
# the mouth can form visemes rather than only opening and closing:
#
#   VITE_AVATAR_URL=https://models.readyplayer.me/<id>.glb?morphTargets=ARKit,Oculus%20Visemes&quality=medium
#
# Left unset, the page uses its own built-in character — and a model that
# fails to load falls back to it too, so the assistant never renders empty.
VITE_AVATAR_URL=
