# Base URL of the GeoIntel backend.
#
# Local development (leave unset to use the default):
#   VITE_API_URL=http://localhost:8000
#
# Production: this MUST be set at build time. Vite inlines the value into the
# bundle, so a build without it ships "http://localhost:8000" and the deployed
# dashboard loads no news.
VITE_API_URL=http://localhost:8000

# Optional 3D avatar for the voice assistant: the URL of any .glb model.
#
# The loader is deliberately source-agnostic. It was first written against
# Ready Player Me, which shut down on 31 January 2026 after being acquired —
# taking every avatar hosted on it. Nothing here depends on a particular
# provider now, and the built-in character remains the fallback for exactly
# that reason: a model that is unset, slow or gone leaves a working head
# rather than an empty box.
#
# Where to get one:
#   * A selfie-to-avatar service such as MetaPerson (avatarsdk.com), which
#     exports GLB.
#   * A free rigged character from Sketchfab, filtered to a permissive licence
#     and the .glb format.
#   * Anything you model yourself.
#
# For the mouth to form visemes rather than only opening and closing, the
# model needs ARKit-style blendshapes (viseme_aa, jawOpen, eyeBlinkLeft, and
# so on). Without them the head still animates, just more simply.
#
# Host it somewhere that sends permissive CORS headers, or the browser will
# refuse to load it.
VITE_AVATAR_URL=
