# ── News providers ───────────────────────────────────────
# Both are optional. Without any key the pipeline still works: RSS
# (including per-country Google News feeds) is keyless and unlimited.
#
# NewsAPI free tier only serves requests from localhost — in production it
# returns 426/429, so do not rely on it for a deployed instance.
NEWS_API_KEY=
# GNews free tier: 100 requests/day, 12-hour delay.
GNEWS_API_KEY=

# ── Database ─────────────────────────────────────────────
# Unset -> local SQLite (geopolitics.db). Set to a Postgres URL in production.
# DATABASE_URL=postgresql://user:pass@host:5432/geointel

# ── Ingestion ────────────────────────────────────────────
# Countries pulled per cycle (the catalog rotates through all 249).
INGEST_BATCH_SIZE=15
# Minutes between scheduled cycles.
INGEST_INTERVAL_MINUTES=30
# Seconds to wait after boot before the first cycle (0 to ingest immediately).
STARTUP_INGEST_DELAY=10
# Articles older than this are purged each cycle.
RETENTION_DAYS=30
# Set false on extra web workers so only one process runs the scheduler.
ENABLE_SCHEDULER=true

# ── Topic classification ─────────────────────────────────
# Stories are labelled by a weighted keyword classifier, which scores 88% on a
# hand-labelled sample of the live corpus (tests/data/gold_headlines.json).
# Its remaining errors are ones vocabulary cannot fix — "15 cats rescued from
# Lebanon's war" contains real conflict words and is not a conflict story — so
# an LLM can be asked to adjudicate.
#
# Measured, and currently OFF because it did not help. Against the labelled
# set, with the keyword classifier at 88%:
#
#     gpt-oss-120b      all 81%   review 87%
#     llama-3.3-70b     all 84%   review 87%
#
# Turn it on only if you change the taxonomy, enlarge the labelled set, or
# improve the prompt — and re-measure before trusting it. Every failure path
# (no key, rate limit, bad JSON, spent budget) falls back to keywords, so
# classification never blocks ingestion either way.
#
# Free key: https://console.groq.com
GROQ_API_KEY=
# off | review (only uncertain stories) | all (every story)
LLM_CLASSIFY=off
GROQ_MODEL=llama-3.1-8b-instant
# Headlines per request. Batching is what keeps this affordable.
LLM_BATCH_SIZE=20
# Hard ceiling on requests per UTC day, tracked in the database.
LLM_DAILY_BUDGET=400

# ── Ask-the-archive assistant ────────────────────────────
# Answers questions using tools that query this site's own data, with the
# articles behind each answer returned alongside it. Reuses GROQ_API_KEY
# above. Without a key the /ask page says so and the rest of the site is
# unaffected.
#
# llama-3.3-70b-versatile rejects these tool definitions with a 400, so the
# default is a model verified against this schema.
AGENT_MODEL=openai/gpt-oss-120b
# The endpoint is public and spends quota: capped per UTC day (tracked in the
# database) and throttled per caller per five minutes.
AGENT_DAILY_BUDGET=300
AGENT_RATE_LIMIT=8
# Speech-to-text, for browsers with no recogniser of their own (Safari,
# Firefox). Chrome and Edge transcribe locally and never call the server.
# Charged against the same daily budget as answering.
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Spoken answers ───────────────────────────────────────
# THIS ONE COSTS MONEY. Everything else in this file is free at the volumes
# involved; Orpheus is billed at roughly $22 per million characters, which is
# about a hundredth of a cent for a typical answer but is not nothing on a
# public page. Hence off by default.
#
# Left off, the assistant speaks with the browser's own synthesis: free,
# offline, universal, and much improved by voice ranking and per-sentence
# prosody on the client. Switched on, answers come back in a human voice that
# takes direction on delivery — grim news read gravely, good news warmly.
#
# The model also requires accepting its terms once, per account, at
# console.groq.com. Until that is done every request returns a 400 and the
# interface quietly falls back.
#
# The real ceiling on the free tier is 100 TTS REQUESTS PER DAY, not the
# money — measured from the endpoint's own rate-limit headers. One answer
# costs one request per chunk, so roughly 50 spoken answers a day. Past that
# it returns 429 and the browser voice takes over until the quota resets.
TTS_ENABLED=false
TTS_MODEL=canopylabs/orpheus-v1-english
# Groq rejects anything outside this list rather than substituting a default:
#   autumn  diana  hannah  austin  daniel  troy
TTS_VOICE=troy
# Characters per request. Groq documents 200; 400 was measured to synthesise
# in full rather than truncate, and fewer requests per answer is what the
# daily cap actually rewards. Drop to 200 if long input is ever cut off.
TTS_CHUNK_CHARS=400

# ── Alerting ─────────────────────────────────────────────
# Pseudo-count that damps alert scores for countries with few articles.
ALERT_CONFIDENCE_WEIGHT=5

# ── Risk history ─────────────────────────────────────────
# How long per-country risk snapshots are kept. One row per active country per
# hour, so ~80 countries x 24h x 30 days is well under 60k rows.
TREND_RETENTION_DAYS=30
# Trailing window each snapshot scores over. A snapshot must describe a
# moment: aggregating the whole corpus made every reading the cumulative
# 30-day mean, so trends and the escalation board tracked corpus growth
# instead of events. Shorter = more responsive but noisier.
SNAPSHOT_WINDOW_HOURS=24

# ── Live broadcast channels ──────────────────────────────
# Optional. Without a key the backend resolves live streams from YouTube's
# public pages. With a key it additionally verifies each stream through the
# YouTube Data API v3, which is the only way to see `status.embeddable`.
#
# Quota: the free allowance is 10,000 units/day. Discovery is done keyless
# (free) and verification uses videos.list (1 unit per 50 videos), so a
# refresh normally costs ~2 units. search.list costs 100 units and is only a
# fallback, capped by the two budgets below — worst case ~4,100 units/day.
YOUTUBE_API_KEY=
# Minutes before a channel's live status is re-checked.
CHANNEL_REFRESH_MINUTES=30
# Max search.list calls per day (100 units each) and per refresh.
YOUTUBE_SEARCH_DAILY_BUDGET=40
YOUTUBE_SEARCH_BUDGET=4

# ── API ──────────────────────────────────────────────────
# Comma-separated allowed origins. Use your frontend URL in production.
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# Shared secret required by the endpoints that write, ingest, or spend
# third-party quota: /ingest-*, /snapshot, POST /countries, POST /sources,
# POST /articles, and the channel write routes. Callers send it as an
# X-API-Key header. Leave unset for local development — the server logs a
# warning at startup — but SET IT before exposing the host: an open
# /ingest-all can be used to drain the GNews and YouTube allowances.
ADMIN_API_KEY=
